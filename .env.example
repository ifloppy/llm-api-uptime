# Probe configuration
PROBE_INTERVAL=5m
PROBE_TIMEOUT=30s
PROBE_CONCURRENCY=3

# Data configuration
DB_PATH=./data/uptime.db
DATA_RETENTION=720h

# Web server configuration
WEB_ENABLED=false
WEB_PORT=8080
WEB_PUBLIC=false
WEB_PASSWORD=

# Guest access (read-only, no sensitive data)
WEB_GUEST_ENABLED=false

# Logging
LOG_LEVEL=info
