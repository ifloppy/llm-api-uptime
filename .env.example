# Probe configuration
PROBE_INTERVAL=5m
PROBE_TIMEOUT=30s
PROBE_RETRIES=2
PROBE_CONCURRENCY=3

# Data configuration
DB_PATH=./data/uptime.db
DATA_RETENTION=720h

# Web server configuration
WEB_ENABLED=false
WEB_PORT=8080
WEB_PUBLIC=false
WEB_PASSWORD=

# Guest access (read-only, no sensitive data)
WEB_GUEST_ENABLED=false

# Logging
LOG_LEVEL=info

# Update checks
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL=24h
UPDATE_AUTO_STAGE=true

# Optional: override the HTTP proxy used for GitHub release requests only.
# Leave empty to inherit HTTPS_PROXY/HTTP_PROXY/no_proxy from the shell.
# UPDATE_HTTP_PROXY=http://proxy.local:8080
